# SEC EDGAR API Compliance (Format: YourName your_email@example.com)
SEC_EDGAR_USER_AGENT=YourName your_email@example.com

# LLM Providers (optional - deterministic mock engine is used if none provided)
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=mock

# Model Configurations
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
FINBERT_MODEL=ProsusAI/finbert
LLM_MODEL_NAME=gemini-2.5-flash

# Storage & Retrieval
DATA_DIR=data
VECTOR_DB_DIR=chroma_db
TOP_K_RETRIEVAL=5
RRF_K=60
